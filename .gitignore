# Espacio de trabajo temporal de las skills de Superpowers: ledger, briefs e
# informes de una ejecucion por subagentes. No es documentacion del proyecto.
.superpowers/

# Cache de bytecode de Python, del generador del tutorial.
__pycache__/

# Sitio generado por MkDocs a partir de docs/*.md. Se reconstruye con
# `uv run --with-requirements docs-requirements.txt --no-project mkdocs build`.
site/

# Cache del plugin git-revision-date-localized: fechas de ultima modificacion
# por fichero, derivadas del propio historial de git. Se regenera sola.
docs/docs-tooling/mkdocs/.cache/

# Configuracion local de los IDE de JetBrains. Es de cada maquina y de cada
# persona, no del proyecto.
.idea/

# Bytecode compilado de Python al ejecutar los scripts y pruebas de tools/.
# Se regenera solo, no aporta nada versionado.
__pycache__/
